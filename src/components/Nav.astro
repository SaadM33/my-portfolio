---
import Icon from "./Icon.astro";
import { nav, site } from "../data/site";
---

<header id="nav" class="fixed inset-x-0 top-0 z-40 transition-all duration-300">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="#top" class="font-mono text-sm font-medium tracking-tight">
      <span class="text-accent">~/</span>{site.handle}<span class="text-muted">.tech</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        nav.map((l) => (
          <a
            href={l.href}
            data-nav
            class="rounded-full px-3.5 py-1.5 text-sm text-muted transition-colors hover:text-fg data-[active]:bg-elevated data-[active]:text-fg"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        aria-label="Toggle color theme"
        class="grid size-9 place-items-center rounded-full border border-border text-muted transition-colors hover:text-fg"
      >
        <Icon name="sun" class="hidden size-4 dark:block" />
        <Icon name="moon" class="size-4 dark:hidden" />
      </button>
      <a
        href={site.resume}
        class="hidden rounded-full bg-fg px-4 py-1.5 text-sm font-medium text-bg transition-opacity hover:opacity-85 sm:inline-block"
        >Resume</a
      >
      <button
        id="menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
        class="grid size-9 place-items-center rounded-full border border-border md:hidden"
      >
        <Icon name="menu" class="size-4" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-b border-border bg-bg/95 backdrop-blur-xl md:hidden">
    <div class="flex flex-col px-4 py-3">
      {
        nav.map((l) => (
          <a href={l.href} class="rounded-lg px-3 py-3 text-muted hover:bg-elevated hover:text-fg">
            {l.label}
          </a>
        ))
      }
      <a href={site.resume} class="rounded-lg px-3 py-3 text-accent">Resume ↗</a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("nav")!;
  const onScroll = () => {
    const scrolled = window.scrollY > 10;
    header.classList.toggle("bg-bg/70", scrolled);
    header.classList.toggle("backdrop-blur-xl", scrolled);
    header.classList.toggle("border-b", scrolled);
    header.classList.toggle("border-border", scrolled);
  };
  onScroll();
  addEventListener("scroll", onScroll, { passive: true });

  // Theme toggle
  document.getElementById("theme-toggle")!.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch {}
  });

  // Mobile menu
  const btn = document.getElementById("menu-btn")!;
  const menu = document.getElementById("mobile-menu")!;
  const setOpen = (open: boolean) => {
    menu.classList.toggle("hidden", !open);
    btn.setAttribute("aria-expanded", String(open));
  };
  btn.addEventListener("click", () => setOpen(menu.classList.contains("hidden")));
  menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

  // Active section highlight
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-nav]")];
  const spy = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((l) => l.toggleAttribute("data-active", l.hash === `#${e.target.id}`));
      }),
    { rootMargin: "-45% 0px -50% 0px" },
  );
  links.forEach((l) => {
    const s = document.querySelector(l.hash);
    if (s) spy.observe(s);
  });
</script>
