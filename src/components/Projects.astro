---
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
import { projects } from "../data/site";

const tags = ["All", ...new Set(projects.flatMap((p) => p.tags))];
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
  <SectionHeading index="03" title="Selected projects" subtitle="Things I've designed, built, and shipped." />

  <div class="reveal mb-8 flex flex-wrap gap-2" role="toolbar" aria-label="Filter projects by technology">
    {
      tags.map((t, i) => (
        <button
          data-filter={t}
          aria-pressed={i === 0 ? "true" : "false"}
          class="rounded-full border border-border px-3.5 py-1.5 text-sm text-muted transition-colors hover:text-fg aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-fg"
        >
          {t}
        </button>
      ))
    }
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    {
      projects.map((p) => (
        <article
          data-tags={p.tags.join("|")}
          class:list={["card reveal group flex flex-col overflow-hidden", p.featured && "md:first:col-span-2"]}
        >
          <div class="relative aspect-[16/8] overflow-hidden border-b border-border bg-elevated">
            {p.image ? (
              <img
                src={p.image}
                alt={`${p.title} screenshot`}
                loading="lazy"
                class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            ) : (
              <>
                <div class="bg-grid absolute inset-0" />
                <div class="absolute inset-0 grid place-items-center">
                  <span class="px-6 text-center font-mono text-xl font-semibold text-gradient sm:text-3xl">{p.title}</span>
                </div>
              </>
            )}
            {p.featured && (
              <span class="absolute top-3 left-3 rounded-full border border-border bg-bg/80 px-2.5 py-1 font-mono text-xs backdrop-blur">
                ★ Featured
              </span>
            )}
          </div>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-xl font-semibold tracking-tight">{p.title}</h3>
              <div class="flex shrink-0 items-center gap-1 text-muted">
                {p.github && (
                  <a href={p.github} target="_blank" rel="noopener" aria-label={`${p.title} source code`} class="grid size-9 place-items-center rounded-full hover:bg-elevated hover:text-fg">
                    <Icon name="github" class="size-[18px]" />
                  </a>
                )}
                {p.live && (
                  <a href={p.live} target="_blank" rel="noopener" aria-label={`${p.title} live demo`} class="grid size-9 place-items-center rounded-full hover:bg-elevated hover:text-fg">
                    <Icon name="external" class="size-[18px]" />
                  </a>
                )}
              </div>
            </div>
            <p class="mt-3 flex-1 leading-relaxed text-muted">{p.description}</p>
            <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-accent">
              {p.tags.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-tags]");
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const f = b.dataset.filter!;
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      cards.forEach((c) => {
        const show = f === "All" || c.dataset.tags!.split("|").includes(f);
        c.hidden = !show;
        if (show) c.classList.add("in");
      });
    }),
  );
</script>
