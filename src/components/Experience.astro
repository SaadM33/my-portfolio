---
import SectionHeading from "./SectionHeading.astro";
import { experience, education } from "../data/site";
---

<section id="experience" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
  <SectionHeading index="04" title="Experience" />
  <div class="grid gap-12 lg:grid-cols-[1.6fr_1fr]">
    <ol class="relative space-y-10 border-l border-border pl-8">
      {
        experience.map((e) => (
          <li class="reveal relative">
            <span class="absolute top-1.5 -left-[37px] size-3 rounded-full border-2 border-accent bg-bg" />
            <p class="font-mono text-xs text-muted">{e.period}</p>
            <h3 class="mt-1 text-lg font-semibold">
              {e.role} <span class="text-muted">@</span> <span class="text-gradient">{e.org}</span>
            </h3>
            <ul class="mt-3 space-y-2 text-muted">
              {e.points.map((pt) => (
                <li class="flex gap-3">
                  <span class="mt-2.5 h-px w-3 shrink-0 bg-accent" />
                  {pt}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="reveal">
      <h3 class="mb-4 font-mono text-sm text-accent">Education</h3>
      <div class="space-y-3">
        {
          education.map((ed) => (
            <div class="card p-5">
              <p class="font-mono text-xs text-muted">{ed.period}</p>
              <p class="mt-1 font-semibold">{ed.degree}</p>
              <p class="text-sm text-muted">{ed.org}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
