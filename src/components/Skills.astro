---
import SectionHeading from "./SectionHeading.astro";
import { skills } from "../data/site";
---

<section id="skills" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
  <SectionHeading index="02" title="Skills & tools" subtitle="The stack I reach for to bring ideas to life." />
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      skills.map((g, i) => (
        <div class="card reveal p-6" style={`transition-delay:${i * 70}ms`}>
          <h3 class="font-mono text-sm text-accent">{g.group}</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {g.items.map((s) => (
              <li class="rounded-md border border-border bg-elevated px-2.5 py-1 text-sm">{s}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
