---
interface Props {
  index: string;
  title: string;
  subtitle?: string;
}
const { index, title, subtitle } = Astro.props;
---

<div class="reveal mb-12">
  <p class="font-mono text-sm text-accent">{index} <span class="text-muted">//</span></p>
  <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-3 max-w-2xl text-muted">{subtitle}</p>}
</div>
