    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 py-8 font-mono text-xs text-muted sm:flex-row sm:px-6"
  >
    <p>© {year} {site.name}. All rights reserved.</p>
    <p>Built with Astro & Tailwind · <a href="#top" class="hover:text-fg">back to top ↑</a></p>
  </div>
</footer>
