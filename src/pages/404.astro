---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout title={`404 — ${site.name}`}>
  <main id="main" class="relative grid min-h-screen place-items-center overflow-hidden px-4 text-center">
    <div class="bg-grid pointer-events-none absolute inset-0"></div>
    <div class="relative">
      <p class="font-mono text-sm text-accent">error 404</p>
      <h1 class="mt-3 text-7xl font-semibold tracking-tighter text-gradient sm:text-9xl">Lost?</h1>
      <p class="mt-4 text-muted">This page doesn't exist — but my portfolio does.</p>
      <a href="/" class="mt-8 inline-block rounded-full bg-fg px-6 py-3 text-sm font-medium text-bg">← Take me home</a>
    </div>
  </main>
</Layout>
