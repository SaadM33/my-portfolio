---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout title={`404 — ${site.fullName}`}>
  <main id="main" class="frame" style="max-width:720px;margin-top:12vh">
    <section class="sheet">
      <div class="sheet-head"><span class="sheet-no">SHEET 404</span><h2>Not in this set</h2><span class="rule"></span></div>
      <p class="lede">This sheet was never drawn. It may have been superseded, or the link has a typo.</p>
      <div class="hero-cta"><a class="btn primary" href="/">← Back to sheet 1</a></div>
    </section>
  </main>
</Layout>
